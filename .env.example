HOST=127.0.0.1
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_API_ORIGIN=/backend-api
# Production must set both values; development/test may use the demo user headers.
AUTH_TRUSTED_USER_HEADER=x-authenticated-user-id
AUTH_PROXY_SHARED_SECRET=
ENABLE_CODEX_TEST_BRIDGE=false
DATABASE_MODE=pglite
PGLITE_PATH=.data/aippt-db
DATABASE_URL=
OBJECT_STORE=local
LOCAL_OBJECT_STORE_PATH=.data/objects
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-model-id
AIPPT_REASONING_MODEL=
AIPPT_FAST_MODEL=
AIPPT_VISION_MODEL=
AIPPT_IMAGE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
FEATURE_DECK_V2=true
FEATURE_GENERATION_WORKFLOW_V2=false
# The V2 quality gate remains active for legacy-generator rollback results.
AIPPT_ENFORCE_QUALITY_GATE_V2=true
FEATURE_IMAGE_DECK=false
FEATURE_INFINITE_CANVAS=false

# Resource research and image providers. The seed library works without keys.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
WIKIMEDIA_USER_AGENT=AIPPT/3.2 (contact@example.com)
STABILITY_API_KEY=

# Resource marketplace and isolated Skill execution.
DEMO_ADMIN_USER_ID=local-demo-user
RESOURCE_UPLOAD_MAX_BYTES=20971520
RESOURCE_AUTO_PUBLISH=true
SKILL_SANDBOX_RUNNER=declarative
SKILL_SANDBOX_IMAGE=
SKILL_SANDBOX_TIMEOUT_MS=120000

# Optional: local Chromium/Edge/Chrome executable for PDF/PNG export.
PLAYWRIGHT_EXECUTABLE_PATH=
