{
  "name": "@aippt/api",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./worker": {
      "types": "./dist/worker-runner.d.ts",
      "import": "./dist/worker-runner.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2"
  },
  "dependencies": {
    "@aippt/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@electric-sql/pglite": "^0.5.5",
    "@fastify/cors": "^11.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.6",
    "jszip": "3.10.1",
    "pptx-automizer": "0.9.0",
    "pptxgenjs": "4.0.1",
    "reveal.js": "6.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
